  "action_rules": {
    "amounts": "Amounts are integer pounds of game money.",
    "go_salary_policy": {
      "pass_or_land": "Collect the board GO salary once per crossing, including a move ending on GO. Never add a second salary just for landing on GO.",
      "none": "Collect no GO salary during this movement."
    },
    "move_to": "Move forward to destination, wrapping around the board as needed.",
    "move_to_nearest": "Find the next matching space in the forward direction, wrapping from position 39 to 0.",
    "move_relative": "New position = (current position + offset) modulo the board space count.",
    "resolve_destination": "Resolve the landed-on space after movement, including any further card draw. Apply rent_override to that landing only. Handle GO salary only once.",
    "rent_override": "Override only rent due on an owned, unmortgaged destination. If unowned, use normal purchase or auction rules. Never charge rent to the owner themselves.",
    "dice_multiplier": "When rent is due, roll two dice again if roll_new_dice is true, then multiply their total by multiplier.",
    "multiply_normal_rent": "Multiply normal station rent, based on the number of stations owned, by multiplier.",
    "go_to_jail": "Move straight to jail, mark the player as imprisoned and end the turn. Do not treat arrival as Just Visiting.",
    "receive": "The bank gives amount to the drawing player.",
    "pay": "The drawing player pays amount to the bank.",
    "pay_each_player": "Pay amount_per_player to every other active player.",
    "collect_from_each_player": "Each other active player pays amount_per_player to the drawing player.",
    "pay_repairs": "Pay the bank: houses owned * amount_per_house + hotels owned * amount_per_hotel. A hotel counts once, without also counting the four houses it replaced.",
    "get_out_of_jail_free": "Retain the card. Its holder may use it to leave jail without paying the release fee, or transfer it. After use, return it to its original deck.",
    "insufficient_funds": "Apply normal asset sale, mortgage and bankruptcy rules when a required payment cannot be made."
  },
